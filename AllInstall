#!/bin/bash
cd ${0%/*} || exit 1    # run from this directory

if [ "$WM_PROJECT_DIR" == "" ] ; then
   source etc/bashrc
   echo "$WM_PROJECT_DIR"
fi

if [ "$PWD" != "$WM_PROJECT_DIR" ] ; then
    echo "Error: Current directory is not \$WM_PROJECT_DIR"
    echo "    The environment variable are not consistent with the installation."
    echo "    Check the OpenFOAM entries in your dot-files and (un)source them."
    exit 1
fi

MS_INST=${MS_INST:-$1}
MS_INST=${MS_INST:-../..}
echo "MS_INST: '${MS_INST}'"

mkdir -p ${MS_INST}/bin/foamxm
mkdir -p ${MS_INST}/lib

cp  $FOAM_APPBIN/*  ${MS_INST}/bin/foamxm/   || echo "not built"
cp  $FOAM_LIBBIN/*  ${MS_INST}/lib/         || echo "not built"

cp -a etc ${MS_INST}/bin/foamxm/
cp -a bin ${MS_INST}/bin/foamxm/
