#!/bin/bash
cd ${0%/*} || exit 1    # run from this directory

if [ "$WM_PROJECT_DIR" == "" ] ; then
   source etc/bashrc
   echo "$WM_PROJECT_DIR"
fi

if [ "$PWD" != "$WM_PROJECT_DIR" ] ; then
    echo "Error: Current directory is not \$WM_PROJECT_DIR, $PWD != $WM_PROJECT_DIR"
    echo "    The environment variable are not consistent with the installation."
    echo "    Check the OpenFOAM entries in your dot-files and (un)source them."
    exit 1
fi

set -ex

# wmake is required for subsequent targets
( cd wmake/src && make )

# build OpenFOAM libraries and applications
src/Allwmake
applications/Allwmake

mv lib inst
mv inst/* inst/lib
mv applications/bin/*  inst/bin
